# --- Web (apps/web) ---------------------------------------------------------
# Leave both empty to run in DEMO MODE (synthetic data, no auth).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used solely to send invitations. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Set to "true" only for a deliberately labelled public demo deployment.
ALLOW_DEMO_MODE=

# --- Worker (apps/worker) ------------------------------------------------------
# Direct Postgres connection string for the worker (service role / postgres user).
DATABASE_URL=
WORKER_POLL_MS=5000
FIXTURE_LATENCY_MS=300
# Provider credentials go here (or your secrets manager) once agreements exist, e.g.:
# LIGHTSTONE_API_KEY=
